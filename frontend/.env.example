# ── AI provider ────────────────────────────────────────────────────────────────
# Switch provider with one setting: "gemini" or "openai".
# Gemini has a free tier (key in a minute at https://aistudio.google.com/apikey).
# Free-tier inputs may be used by Google to improve its products, so test with sample resumes.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
# Set to true once the Google project has billing on (paid tier: Google doesn't use inputs
# to improve its products). The privacy policy reads this to describe the right terms.
# GEMINI_PAID_TIER=true

# Used when AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# Optional: override the model (defaults: gemini-3.6-flash, gpt-4o)
# AI_MODEL=

# Optional — API base URL (leave empty to use built-in Next.js API routes)
# NEXT_PUBLIC_API_URL=

# Required for shareable profiles — Upstash Redis (Vercel KV)
# Create a free store at https://console.upstash.com or via Vercel Marketplace
KV_REST_API_URL=https://your-store.upstash.io
KV_REST_API_TOKEN=your-token-here

# Recommended in production — secret salt for hashing visitor IPs in rate limiting.
# Rate limits use the same Upstash store above; without it, limits are disabled.
RATE_LIMIT_SALT=any-long-random-string

# Pro features (international CV formats, shareable profile). Free during the beta;
# set to false once payments are live so only Pro accounts can use them.
PRO_FEATURES_UNLOCKED=true
